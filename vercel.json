{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/language.js",
      "destination": "/404",
      "statusCode": 410
    },
    {
      "source": "/language.css",
      "destination": "/404",
      "statusCode": 410
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|webp|avif|gif|svg|ico|woff|woff2|mp4|webm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    }
  ]
}
